// Estrutura de repetição
    // for
    for(let y = 1; y <= 10; y++) //y é igual a 1, enquanto y for menor, ou igual a 10 vai adicionar 1
        console.log(y)

    // break - para a execução do loop
    for(let x = 20; x > 0; x--) { //x é igual a 20, enquanto x for maior que 0, vai tirar 1
        if(x === 13) {
            break; //qnd x chegar em 13 vai parar
        }
        console.log(x)
    }

    // continue - pula a execução do momento 
    for(let i = 10; i > 0; i--) { // i é igual a 10, enquanto i for maior que 0, vai tirar 1
        if(i === 5) {
            continue; //qnd i chegar em 5, vai pular e continuar no próximo
        }
        console.log(i)
    }
    